{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object", "additionalProperties": false,
  "required": ["version", "mode", "cells"],
  "properties": {
    "version": {"const": 1},
    "mode": {"enum": ["shared", "isolated-clusters"]},
    "cells": {
      "type": "array", "minItems": 1, "maxItems": 100,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "platform", "services"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"},
          "platform": {"type": "string", "minLength": 1},
          "grafanaDatabaseIdentity": {"type": "string", "pattern": "^[a-zA-Z0-9.-]+/[a-zA-Z0-9_-]+$"},
          "services": {"type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true,
                       "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}/[a-z][a-z0-9-]{1,62}$"}}
        }
      }
    }
  }
}
