{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "access": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": ["port-forward", "ingress", "external-proxy"]
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "proxyNamespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9.-]{0,61}[a-z0-9])?$"
        },
        "ingressClassName": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9.-]{0,61}[a-z0-9])?$"
        },
        "tlsSecretName": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9.-]{0,61}[a-z0-9])?$"
        }
      },
      "required": ["mode", "url"]
    },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": ["local", "oauth"]
        },
        "secretName": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9.-]{0,61}[a-z0-9])?$"
        },
        "authURL": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "tokenURL": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "userInfoURL": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "scopes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_:.\\/-]{1,128}$"
          }
        },
        "groupsClaim": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*$"
        },
        "roles": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "Viewer": {
              "type": "array",
              "minItems": 1,
              "maxItems": 50,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@-]{0,127}$"
              }
            },
            "Editor": {
              "type": "array",
              "minItems": 1,
              "maxItems": 50,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@-]{0,127}$"
              }
            },
            "Admin": {
              "type": "array",
              "minItems": 1,
              "maxItems": 50,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@-]{0,127}$"
              }
            }
          },
          "required": [],
          "minProperties": 1
        },
        "useRefreshToken": {
          "type": "boolean"
        },
        "caConfigMap": {
          "type": "string",
          "pattern": "^[a-z0-9]([a-z0-9.-]{0,61}[a-z0-9])?$"
        }
      },
      "required": ["mode"]
    },
    "internalTransport": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": ["cluster-network", "existing-mesh"]
        },
        "provider": {
          "enum": ["istio", "linkerd"]
        },
        "grafanaClientIdentities": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        }
      },
      "required": ["mode"]
    },
    "serverSecretName": {
      "type": "string",
      "pattern": "^[a-z0-9]([a-z0-9.-]{0,61}[a-z0-9])?$"
    }
  },
  "required": [
    "version",
    "access",
    "authentication",
    "internalTransport",
    "serverSecretName"
  ]
}
