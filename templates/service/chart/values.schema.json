{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "image",
    "replicas",
    "profiling"
  ],
  "properties": {
    "image": {
      "type": "string",
      "pattern": "^.+@sha256:[a-f0-9]{64}$"
    },
    "replicas": {
      "type": "integer",
      "minimum": 3,
      "maximum": 30
    },
    "profiling": {
      "type": "boolean"
    }
  }
}
