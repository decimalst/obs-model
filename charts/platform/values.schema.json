{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "region",
    "clusterName",
    "quota",
    "logs",
    "collectors",
    "images"
  ],
  "properties": {
    "region": {
      "type": "string",
      "pattern": "^[a-z]{2}-[a-z]+-[0-9]$"
    },
    "clusterName": {
      "type": "string",
      "minLength": 1
    },
    "storageClass": {
      "type": "string",
      "minLength": 1
    },
    "images": {
      "type": "object",
      "required": [
        "vector",
        "otel",
        "quota"
      ],
      "additionalProperties": {
        "type": "string",
        "pattern": "^.+(:[0-9][A-Za-z0-9._-]*|@sha256:[a-f0-9]{64})$"
      }
    },
    "quota": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicas",
        "eventsPerSecond",
        "eventBurst",
        "bytesPerSecond",
        "byteBurst",
        "debugEventsPerSecond",
        "debugEventBurst",
        "debugBytesPerSecond",
        "debugByteBurst",
        "redisAddress",
        "redisTLS",
        "secretName"
      ],
      "properties": {
        "eventsPerSecond": {
          "type": "integer",
          "minimum": 1
        },
        "eventBurst": {
          "type": "integer",
          "minimum": 1
        },
        "bytesPerSecond": {
          "type": "integer",
          "minimum": 1
        },
        "byteBurst": {
          "type": "integer",
          "minimum": 1
        },
        "debugEventsPerSecond": {
          "type": "integer",
          "minimum": 1
        },
        "debugEventBurst": {
          "type": "integer",
          "minimum": 1
        },
        "debugBytesPerSecond": {
          "type": "integer",
          "minimum": 1
        },
        "debugByteBurst": {
          "type": "integer",
          "minimum": 1
        },
        "replicas": {
          "type": "integer",
          "minimum": 3
        },
        "redisAddress": {
          "type": "string",
          "minLength": 1
        },
        "redisTLS": {
          "type": "boolean"
        },
        "secretName": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "logs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agentEventsPerSecond": {
          "type": "integer",
          "minimum": 1
        },
        "retentionDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 90
        },
        "kafkaRetentionHours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 168
        },
        "kafkaStorage": {
          "type": "string"
        },
        "clickhouseStorage": {
          "type": "string"
        },
        "secretName": {
          "type": "string"
        },
        "maxDebugHours": {
          "const": 24
        }
      }
    },
    "collectors": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": {
          "const": 3
        },
        "traceSamplingPercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "traceSpansPerSecond": {
          "type": "integer",
          "minimum": 1
        },
        "traceDecisionWaitSeconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 120
        },
        "maxTraces": {
          "type": "integer",
          "minimum": 1
        },
        "scrapeInterval": {
          "type": "string",
          "pattern": "^[1-9][0-9]*s$"
        },
        "scrapeSampleLimit": {
          "type": "integer",
          "minimum": 1
        },
        "scrapeNamespaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "rollouts": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "autoPromotionEnabled": {
          "type": "boolean"
        },
        "scaleDownDelaySeconds": {
          "type": "integer",
          "minimum": 30
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 3,
          "maximum": 30
        },
        "targetCPU": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    }
  }
}
