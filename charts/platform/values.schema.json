{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "region",
    "clusterName",
    "quota",
    "logs",
    "collectors",
    "images"
  ],
  "properties": {
    "region": {
      "type": "string",
      "pattern": "^[a-z]{2}-[a-z]+-[0-9]$"
    },
    "clusterName": {
      "type": "string",
      "minLength": 1
    },
    "storageClass": {
      "type": "string",
      "minLength": 1
    },
    "images": {
      "type": "object",
      "required": [
        "vector",
        "otel",
        "quota"
      ],
      "additionalProperties": {
        "type": "string",
        "pattern": "^.+(:[0-9][A-Za-z0-9._-]*|@sha256:[a-f0-9]{64})$"
      }
    },
    "quota": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "replicas",
        "eventsPerSecond",
        "eventBurst",
        "bytesPerSecond",
        "byteBurst",
        "debugEventsPerSecond",
        "debugEventBurst",
        "debugBytesPerSecond",
        "debugByteBurst",
        "redisAddress",
        "redisTLS",
        "secretName"
      ],
      "properties": {
        "eventsPerSecond": {
          "type": "integer",
          "minimum": 1
        },
        "eventBurst": {
          "type": "integer",
          "minimum": 1
        },
        "bytesPerSecond": {
          "type": "integer",
          "minimum": 1
        },
        "byteBurst": {
          "type": "integer",
          "minimum": 1
        },
        "debugEventsPerSecond": {
          "type": "integer",
          "minimum": 1
        },
        "debugEventBurst": {
          "type": "integer",
          "minimum": 1
        },
        "debugBytesPerSecond": {
          "type": "integer",
          "minimum": 1
        },
        "debugByteBurst": {
          "type": "integer",
          "minimum": 1
        },
        "replicas": {
          "type": "integer",
          "minimum": 3
        },
        "redisAddress": {
          "type": "string",
          "minLength": 1
        },
        "redisTLS": {
          "type": "boolean"
        },
        "secretName": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "logs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agentEventsPerSecond": {
          "type": "integer",
          "minimum": 1
        },
        "retentionDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 90
        },
        "kafkaRetentionHours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 168
        },
        "kafkaStorage": {
          "type": "string"
        },
        "clickhouseStorage": {
          "type": "string"
        },
        "secretName": {
          "type": "string"
        },
        "maxDebugHours": {
          "const": 24
        },
        "agentBufferBytes": {
          "type": "integer",
          "minimum": 268435488
        },
        "gatewayBufferEvents": {
          "type": "integer",
          "minimum": 1
        },
        "writerBufferEvents": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "collectors": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": {
          "const": 3
        },
        "traceSamplingPercent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "traceSpansPerSecond": {
          "type": "integer",
          "minimum": 1
        },
        "traceDecisionWaitSeconds": {
          "type": "integer",
          "minimum": 10,
          "maximum": 120
        },
        "maxTraces": {
          "type": "integer",
          "minimum": 1
        },
        "scrapeInterval": {
          "type": "string",
          "pattern": "^[1-9][0-9]*s$"
        },
        "scrapeSampleLimit": {
          "type": "integer",
          "minimum": 1
        },
        "scrapeNamespaces": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "arrowStreams": {
          "type": "integer",
          "minimum": 1,
          "maximum": 16
        },
        "arrowMemoryMiB": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "arrowRequestMiB": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "arrowWaitingMiB": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "queueSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "queueConsumers": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "batchSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "batchMaxSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "maxReceiveMiB": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "maxConcurrentStreams": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "traceExpectedPerSecond": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "traceDecisionCache": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "traceSlowMilliseconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000000
        },
        "traceErrorAllocation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "traceSlowAllocation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "traceBaselineAllocation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "interconnect": {
          "enum": [
            "arrow",
            "otlp"
          ]
        },
        "requireMetricIdentity": {
          "type": "boolean"
        },
        "batchTimeout": {
          "type": "string",
          "pattern": "^[1-9][0-9]*s$"
        },
        "scrapeTimeout": {
          "type": "string",
          "pattern": "^[1-9][0-9]*s$"
        },
        "arrowQueueItems": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        }
      }
    },
    "rollouts": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "autoPromotionEnabled": {
          "type": "boolean"
        },
        "scaleDownDelaySeconds": {
          "type": "integer",
          "minimum": 30
        }
      }
    },
    "autoscaling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 3,
          "maximum": 30
        },
        "targetCPU": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "createStorageClass": {
      "type": "boolean"
    },
    "mimir": {
      "type": "object",
      "properties": {
        "mimir": {
          "type": "object",
          "properties": {
            "structuredConfig": {
              "type": "object",
              "properties": {
                "limits": {
                  "type": "object",
                  "properties": {
                    "ingestion_rate": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "ingestion_burst_size": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "max_global_series_per_user": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "compactor_blocks_retention_period": {
                      "type": "string",
                      "pattern": "^[1-9][0-9]*[smhd]$"
                    },
                    "max_query_parallelism": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "max_global_series_per_metric": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "max_label_names_per_series": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "max_label_name_length": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "max_label_value_length": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "max_fetched_series_per_query": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "max_fetched_chunk_bytes_per_query": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "out_of_order_time_window": {
                      "type": "string",
                      "pattern": "^[1-9][0-9]*[smhd]$"
                    },
                    "max_query_lookback": {
                      "type": "string",
                      "pattern": "^[1-9][0-9]*[smhd]$"
                    },
                    "metric_relabel_configs": {
                      "type": "array",
                      "minItems": 1,
                      "items": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "action",
                          "source_labels",
                          "separator",
                          "regex"
                        ],
                        "properties": {
                          "action": {
                            "const": "drop"
                          },
                          "source_labels": {
                            "type": "array",
                            "minItems": 1,
                            "uniqueItems": true,
                            "items": {
                              "type": "string",
                              "pattern": "^[a-zA-Z_][a-zA-Z0-9_]*$"
                            },
                            "maxItems": 1
                          },
                          "separator": {
                            "const": ";"
                          },
                          "regex": {
                            "const": ".+"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "ingester": {
          "type": "object",
          "properties": {
            "replicas": {
              "type": "integer",
              "minimum": 3,
              "multipleOf": 3
            }
          }
        }
      }
    },
    "tempo": {
      "type": "object",
      "properties": {
        "overrides": {
          "type": "object",
          "properties": {
            "defaults": {
              "type": "object",
              "properties": {
                "ingestion": {
                  "type": "object",
                  "properties": {
                    "rate_strategy": {
                      "const": "global"
                    },
                    "rate_limit_bytes": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "burst_size_bytes": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                },
                "global": {
                  "type": "object",
                  "properties": {
                    "max_bytes_per_trace": {
                      "type": "integer",
                      "minimum": 1
                    }
                  }
                }
              }
            }
          }
        },
        "compactor": {
          "type": "object",
          "properties": {
            "config": {
              "type": "object",
              "properties": {
                "compaction": {
                  "type": "object",
                  "properties": {
                    "block_retention": {
                      "type": "string",
                      "pattern": "^[1-9][0-9]*h$"
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "scaling": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "writerReplicas": {
          "type": "integer",
          "minimum": 3,
          "maximum": 120
        },
        "scrapeReplicas": {
          "type": "integer",
          "minimum": 3,
          "maximum": 120
        },
        "extraKafkaBrokers": {
          "type": "integer",
          "minimum": 0,
          "maximum": 120,
          "multipleOf": 3
        },
        "logPartitions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        },
        "metricsPartitions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 120
        }
      }
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agents",
        "gateways",
        "samplers",
        "writers",
        "quota",
        "scrape",
        "targetAllocator",
        "kafka",
        "clickhouse",
        "keeper"
      ],
      "properties": {
        "agents": {
          "$ref": "#/definitions/componentResources"
        },
        "gateways": {
          "$ref": "#/definitions/componentResources"
        },
        "samplers": {
          "$ref": "#/definitions/componentResources"
        },
        "writers": {
          "$ref": "#/definitions/componentResources"
        },
        "quota": {
          "$ref": "#/definitions/componentResources"
        },
        "scrape": {
          "$ref": "#/definitions/componentResources"
        },
        "targetAllocator": {
          "$ref": "#/definitions/componentResources"
        },
        "kafka": {
          "$ref": "#/definitions/componentResources"
        },
        "clickhouse": {
          "$ref": "#/definitions/componentResources"
        },
        "keeper": {
          "$ref": "#/definitions/componentResources"
        }
      }
    },
    "clickhouse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shards",
        "replicas",
        "insertQuorum",
        "insertQuorumTimeoutMs",
        "schemaJob",
        "pauseWrites"
      ],
      "properties": {
        "shards": {
          "type": "integer",
          "minimum": 2,
          "maximum": 32
        },
        "replicas": {
          "const": 3
        },
        "insertQuorum": {
          "const": 2
        },
        "insertQuorumTimeoutMs": {
          "type": "integer",
          "minimum": 1000,
          "maximum": 60000
        },
        "schemaJob": {
          "type": "boolean"
        },
        "pauseWrites": {
          "type": "boolean"
        }
      }
    },
    "writerAutoscaling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "maxReplicas",
        "lagThreshold",
        "pollingInterval",
        "scaleDownStabilizationSeconds",
        "scaleUpPodsPerMinute",
        "scaleDownPodsPerMinute"
      ],
      "properties": {
        "mode": {
          "enum": [
            "kafka",
            "cpu"
          ]
        },
        "maxReplicas": {
          "type": "integer",
          "minimum": 3,
          "maximum": 256
        },
        "lagThreshold": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000000
        },
        "pollingInterval": {
          "type": "integer",
          "minimum": 5,
          "maximum": 120
        },
        "scaleDownStabilizationSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 3600
        },
        "scaleUpPodsPerMinute": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "scaleDownPodsPerMinute": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        }
      }
    },
    "spanMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "spanKinds",
        "includeHttpRoute",
        "aggregationCardinalityLimit",
        "resourceMetricsCacheSize",
        "flushIntervalSeconds",
        "expirationSeconds",
        "histogramBucketsSeconds"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "spanKinds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "enum": [
              "SERVER",
              "CONSUMER"
            ]
          }
        },
        "includeHttpRoute": {
          "type": "boolean"
        },
        "aggregationCardinalityLimit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "resourceMetricsCacheSize": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "flushIntervalSeconds": {
          "type": "integer",
          "minimum": 5,
          "maximum": 60
        },
        "expirationSeconds": {
          "type": "integer",
          "minimum": 30,
          "maximum": 3600
        },
        "histogramBucketsSeconds": {
          "type": "array",
          "minItems": 2,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 300
          }
        }
      }
    },
    "hubble": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "metricsPort",
        "sampleLimit"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "metricsPort": {
          "const": 9965
        },
        "sampleLimit": {
          "type": "integer",
          "minimum": 100,
          "maximum": 50000
        }
      }
    },
    "profiling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "image",
        "namespaces",
        "sampleRate",
        "collectIntervalSeconds",
        "resources"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "string",
          "pattern": "^grafana/alloy:v[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "namespaces": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
            "maxLength": 63
          }
        },
        "sampleRate": {
          "type": "integer",
          "minimum": 1,
          "maximum": 99
        },
        "collectIntervalSeconds": {
          "type": "integer",
          "minimum": 15,
          "maximum": 300
        },
        "resources": {
          "$ref": "#/definitions/componentResources"
        }
      }
    },
    "pyroscope": {
      "type": "object",
      "properties": {
        "pyroscope": {
          "type": "object",
          "properties": {
            "structuredConfig": {
              "type": "object",
              "properties": {
                "limits": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "max_profile_size_bytes": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 16777216
                    },
                    "max_profile_stacktrace_samples": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 100000
                    },
                    "max_profile_stacktrace_depth": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 1000
                    },
                    "max_profile_stacktrace_sample_labels": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 16
                    },
                    "max_label_names_per_series": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 30
                    },
                    "max_label_value_length": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 128
                    },
                    "ingestion_rate_mb": {
                      "type": "number",
                      "minimum": 0.1,
                      "maximum": 1024
                    },
                    "ingestion_burst_size_mb": {
                      "type": "number",
                      "minimum": 0.1,
                      "maximum": 1024
                    },
                    "retention_period": {
                      "type": "string",
                      "pattern": "^[1-9][0-9]{0,3}h$"
                    }
                  }
                }
              }
            },
            "components": {
              "type": "object",
              "properties": {
                "distributor": {
                  "type": "object",
                  "properties": {
                    "replicaCount": {
                      "type": "integer",
                      "minimum": 3,
                      "maximum": 30
                    }
                  }
                },
                "query-frontend": {
                  "type": "object",
                  "properties": {
                    "replicaCount": {
                      "type": "integer",
                      "minimum": 3,
                      "maximum": 30
                    }
                  }
                },
                "query-backend": {
                  "type": "object",
                  "properties": {
                    "replicaCount": {
                      "type": "integer",
                      "minimum": 3,
                      "maximum": 30
                    }
                  }
                },
                "segment-writer": {
                  "type": "object",
                  "properties": {
                    "replicaCount": {
                      "type": "integer",
                      "minimum": 3,
                      "maximum": 30
                    }
                  }
                },
                "metastore": {
                  "type": "object",
                  "properties": {
                    "replicaCount": {
                      "const": 3
                    }
                  }
                },
                "compaction-worker": {
                  "type": "object",
                  "properties": {
                    "replicaCount": {
                      "type": "integer",
                      "minimum": 3,
                      "maximum": 30
                    }
                  }
                },
                "tenant-settings": {
                  "type": "object",
                  "properties": {
                    "replicaCount": {
                      "type": "integer",
                      "minimum": 2,
                      "maximum": 30
                    }
                  }
                },
                "ad-hoc-profiles": {
                  "type": "object",
                  "properties": {
                    "replicaCount": {
                      "type": "integer",
                      "minimum": 2,
                      "maximum": 30
                    }
                  }
                },
                "admin": {
                  "type": "object",
                  "properties": {
                    "replicaCount": {
                      "type": "integer",
                      "minimum": 2,
                      "maximum": 30
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "image",
        "intervalSeconds",
        "canary"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "string",
          "pattern": "^.+(:[0-9][^ ]*|@sha256:[a-f0-9]{64})$"
        },
        "intervalSeconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 900
        },
        "canary": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "deadlineSeconds",
            "pollSeconds",
            "secretName"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "deadlineSeconds": {
              "type": "integer",
              "minimum": 30,
              "maximum": 300
            },
            "pollSeconds": {
              "type": "integer",
              "minimum": 2,
              "maximum": 30
            },
            "secretName": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,62}$"
            }
          }
        }
      }
    },
    "notifications": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "manageTenantConfig",
        "secretName",
        "defaultReceiverKey",
        "owners"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "manageTenantConfig": {
          "type": "boolean"
        },
        "secretName": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,62}$"
        },
        "defaultReceiverKey": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,62}$"
        },
        "owners": {
          "type": "object",
          "maxProperties": 100,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9-]{1,61}[a-z0-9]$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,62}$"
          }
        }
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "logs": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "off",
                "redact",
                "drop"
