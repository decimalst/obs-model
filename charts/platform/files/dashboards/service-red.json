{
  "uid": "service-red",
  "title": "Service RED \u2014 observed traffic",
  "description": "Rate, errors and duration derived from received spans before tail sampling. Server spans by default. No data means absent/expired telemetry, not healthy zero traffic. SDK sampling, collector loss and retries affect counts; these are not billing or SLO-grade counters. Error traces are sampled and may not contain every counted error.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "region",
        "label": "Region",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir"
        },
        "query": {
          "query": "label_values(platform_red_calls_total, cloud_region)",
          "refId": "region"
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "cluster",
        "label": "Cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir"
        },
        "query": {
          "query": "label_values(platform_red_calls_total{cloud_region=~\"$region\"}, k8s_cluster_name)",
          "refId": "cluster"
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir"
        },
        "query": {
          "query": "label_values(platform_red_calls_total{k8s_cluster_name=~\"$cluster\"}, service_namespace)",
          "refId": "namespace"
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "service",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir"
        },
        "query": {
          "query": "label_values(platform_red_calls_total{k8s_cluster_name=~\"$cluster\",service_namespace=~\"$namespace\"}, service_name)",
          "refId": "service"
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "kind",
        "label": "Span kind",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "mimir"
        },
        "query": {
          "query": "label_values(platform_red_calls_total, span_kind)",
          "refId": "kind"
        },
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "selected": true,
          "text": [
            "SPAN_KIND_SERVER"
          ],
          "value": [
            "SPAN_KIND_SERVER"
          ]
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Request rate",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name, service_namespace) (service:red_requests:rate5m{cloud_region=~\"$region\",k8s_cluster_name=~\"$cluster\",service_namespace=~\"$namespace\",service_name=~\"$service\",span_kind=~\"$kind\"})",
          "legendFormat": "{{service_namespace}} / {{service_name}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Error ratio",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name, service_namespace) (service:red_errors:rate5m{cloud_region=~\"$region\",k8s_cluster_name=~\"$cluster\",service_namespace=~\"$namespace\",service_name=~\"$service\",span_kind=~\"$kind\"}) / (sum by (service_name, service_namespace) (service:red_requests:rate5m{cloud_region=~\"$region\",k8s_cluster_name=~\"$cluster\",service_namespace=~\"$namespace\",service_name=~\"$service\",span_kind=~\"$kind\"}) > 0)",
          "legendFormat": "{{service_namespace}} / {{service_name}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "Latency p50 / p95 / p99",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (service_name, service_namespace, le) (service:red_duration_seconds_bucket:rate5m{cloud_region=~\"$region\",k8s_cluster_name=~\"$cluster\",service_namespace=~\"$namespace\",service_name=~\"$service\",span_kind=~\"$kind\"}))",
          "legendFormat": "p50 {{service_namespace}} / {{service_name}}"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum by (service_name, service_namespace, le) (service:red_duration_seconds_bucket:rate5m{cloud_region=~\"$region\",k8s_cluster_name=~\"$cluster\",service_namespace=~\"$namespace\",service_name=~\"$service\",span_kind=~\"$kind\"}))",
          "legendFormat": "p95 {{service_namespace}} / {{service_name}}"
        },
        {
          "refId": "C",
          "expr": "histogram_quantile(0.99, sum by (service_name, service_namespace, le) (service:red_duration_seconds_bucket:rate5m{cloud_region=~\"$region\",k8s_cluster_name=~\"$cluster\",service_namespace=~\"$namespace\",service_name=~\"$service\",span_kind=~\"$kind\"}))",
          "legendFormat": "p99 {{service_namespace}} / {{service_name}}"
        }
      ]
    },
    {
      "id": 4,
      "title": "Requests by service",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name, service_namespace) (service:red_requests:rate5m{cloud_region=~\"$region\",k8s_cluster_name=~\"$cluster\",service_namespace=~\"$namespace\",service_name=~\"$service\",span_kind=~\"$kind\"})",
          "legendFormat": "{{service_namespace}} / {{service_name}}"
        }
      ]
    },
    {
      "id": 5,
      "title": "Errors per second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name, service_namespace) (service:red_errors:rate5m{cloud_region=~\"$region\",k8s_cluster_name=~\"$cluster\",service_namespace=~\"$namespace\",service_name=~\"$service\",span_kind=~\"$kind\"})",
          "legendFormat": "{{service_namespace}} / {{service_name}}"
        }
      ]
    },
    {
      "id": 6,
      "title": "Cardinality overflow events",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (k8s_cluster_name) (increase(platform_red_calls_total{cloud_region=~\"$region\",k8s_cluster_name=~\"$cluster\",otel_metric_overflow=\"true\"}[5m]))",
          "legendFormat": "{{k8s_cluster_name}}"
        }
      ]
    },
    {
      "id": 7,
      "title": "Retained error traces (all span kinds)",
      "type": "table",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "traceql",
          "query": "{ resource.service.name =~ \"${service:regex}\" && resource.service.namespace =~ \"${namespace:regex}\" && resource.k8s.cluster.name =~ \"${cluster:regex}\" && resource.cloud.region =~ \"${region:regex}\" && status = error }",
          "limit": 20
        }
      ],
      "description": "Matches original service namespace, service, region and cluster. Trace retention and error status can differ from the RED branch."
    }
  ]
}
