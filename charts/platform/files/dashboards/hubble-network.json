{
  "uid": "hubble-network",
  "title": "Regional network visibility",
  "description": "Cilium Hubble metrics, not CPU profiles or full application dependency tracing. If the bounded scrape exceeds sample_limit, the whole scrape fails; check exporter reachability.",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "Hubble exporters reachable",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "up{job=\"hubble\"}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Network flows / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (source, destination, verdict) (rate(hubble_flows_processed_total[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "Dropped packets / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (reason) (rate(hubble_drop_total[5m]))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "TCP flags / second",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "mimir"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "sum by (flag) (rate(hubble_tcp_flags_total[5m]))",
          "refId": "A"
        }
      ]
    }
  ]
}
